  "dependencies": {
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "mongodb-memory-server": "^10.4.3"
  }
