# ============================================================
# BACKEND ENVIRONMENT VARIABLES (copy to backend/.env)
# Never commit the real .env file. .env is git-ignored.
# ============================================================

# ---- Server ----
# Port the Express server listens on (Render injects its own PORT automatically).
PORT=5000

# Node environment: "development" locally, "production" on Render.
NODE_ENV=development

# ---- MongoDB Atlas ----
# Connection string from Atlas > Connect > Drivers.
# IMPORTANT: if your DB password contains special characters (@ : / ? # & %),
# they MUST be URL-encoded. Example: the password "ManzarAbbas@512" becomes
# "ManzarAbbas%40512" (@ -> %40). Replace <cluster> with your real cluster host.
MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=dt0cofvln
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- Admin auth ----
# Password required to save content / upload images from the Admin Panel.
# Sent by the frontend as the "x-admin-key" header and verified server-side.
ADMIN_PASSWORD=change_me_to_a_strong_secret

# ---- CORS ----
# Comma-separated list of allowed frontend origins (no trailing slash).
# Local dev + your deployed Vercel URL. Leave empty to allow all (NOT recommended).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
