{
  "name": "manzar-portfolio-backend",
  "version": "1.0.0",
  "description": "Production backend for the Manzar Abbas portfolio — Express + MongoDB Atlas + Cloudinary.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/integration.test.js && node test/frontend.test.js && node test/e2e.test.js",
    "test:integration": "node test/integration.test.js",
    "test:frontend": "node test/frontend.test.js",
    "test:e2e": "node test/e2e.test.js",
    "test:cloudinary": "node test/cloudinary.test.js",
    "test:upload": "node test/upload.test.js"
